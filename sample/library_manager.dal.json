{"5936e1f3-f1f2-4966-9aff-d7bb8cc7458e":{"name":"library_manager.py","key":"library_manager.py","content":"from typing import Optional\r\n\r\nbasket: list[dict] = []\r\nbook_shelf: dict[str, list[dict]] = {}\r\n\r\n\r\ndef PresentMenuAndAcceptUserChoice() -> str:\r\n    \"\"\"\r\n    Presents the menu to the user and accepts their choice.\r\n    \"\"\"\r\n    print(\"\\nMenu\")\r\n    print(\"----\")\r\n    print(\"a: Add book to basket\")\r\n    print(\"p: Place books on shelf\")\r\n    print(\"d: Audit library\")\r\n    print(\"Any other key: Exit\")\r\n    response = input(\"Choice: \").strip().lower()\r\n    return response\r\n\r\n\r\ndef GetBookFromBasket() -> Optional[dict]:\r\n    \"\"\"\r\n    Gets a book from the basket.\r\n    Participants:\r\n    - Book\r\n    - Basket\r\n    \"\"\"\r\n    if not basket:\r\n        return None\r\n    return basket.pop(0)\r\n\r\n\r\ndef GetFirstLetterOfBookName(book: dict) -> str:\r\n    \"\"\"\r\n    Gets the first letter of the book name.\r\n    Participant:\r\n    - FirstLetter\r\n    \"\"\"\r\n    return book[\"name\"][0]\r\n\r\n\r\ndef CreateSlotOnBookShelf(first_letter: str) -> None:\r\n    \"\"\"\r\n    Creates a slot on the bookshelf.\r\n    Participant:\r\n    - BookShelf\r\n    \"\"\"\r\n    if first_letter not in book_shelf:\r\n        book_shelf[first_letter] = []\r\n\r\n\r\ndef AddBookToShelf(book: dict, first_letter: str) -> None:\r\n    \"\"\"\r\n    Adds a book to the bookshelf.\r\n    Participants:\r\n    - Book\r\n    - BookShelf\r\n    \"\"\"\r\n    book_shelf[first_letter].append(book)\r\n\r\n\r\ndef AcceptBook() -> dict:\r\n    \"\"\"\r\n    Accepts a book with a name and genre.\r\n\r\n    Participant:\r\n    - Book\r\n    \"\"\"\r\n    name = input(\"Book name: \")\r\n    genre = input(\"Book genre: \")\r\n\r\n    book = {\r\n        \"name\": name,\r\n        \"genre\": genre,\r\n    }\r\n\r\n    return book\r\n\r\n\r\ndef PlaceBookInBasket(book: dict) -> None:\r\n    \"\"\"\r\n    Places the book in the basket.\r\n    Participants:\r\n    - Basket\r\n    - Book\r\n    \"\"\"\r\n    basket.append(book)\r\n\r\n\r\ndef GenerateAuditReport() -> dict:\r\n    \"\"\"\r\n    Generates the audit report.\r\n    Participant:\r\n    - AuditReport\r\n    \"\"\"\r\n    return {\r\n        \"basket\": list(basket),\r\n        \"book_shelf\": {key: list(value) for key, value in book_shelf.items()},\r\n    }\r\n\r\n\r\ndef HandBookToUser(item: dict) -> None:\r\n    \"\"\"\r\n    Hands the result to the user.\r\n\r\n    The design routes GenerateAuditReport -> HandBookToUser,\r\n    so this function displays the produced result to the user.\r\n    \"\"\"\r\n    print(\"\\nAudit Report\")\r\n    print(\"------------\")\r\n    print(item)\r\n\r\n\r\ndef ExecutePlaceBooksOnShelfPath() -> None:\r\n    \"\"\"\r\n    Realizes:\r\n\r\n    AcceptChoiceToPlaceBooksOnShelf\r\n      -> GetBookFromBasket\r\n      -> GetFirstLetterOfBookName\r\n      -> CreateSlotOnBookShelf / AddBookToShelf\r\n      -> GetBookFromBasket\r\n    \"\"\"\r\n    while True:\r\n        book = GetBookFromBasket()\r\n        if book is None:\r\n            break\r\n\r\n        first_letter = GetFirstLetterOfBookName(book)\r\n\r\n        if first_letter not in book_shelf:\r\n            CreateSlotOnBookShelf(first_letter)\r\n\r\n        AddBookToShelf(book, first_letter)\r\n\r\n\r\ndef ExecuteAddBookToBasketPath() -> None:\r\n    \"\"\"\r\n    Realizes:\r\n\r\n    AcceptChoiceToAddBookToBasket\r\n      -> AcceptBook\r\n      -> PlaceBookInBasket\r\n    \"\"\"\r\n    book = AcceptBook()\r\n    PlaceBookInBasket(book)\r\n\r\n\r\ndef ExecuteAuditLibraryPath() -> None:\r\n    \"\"\"\r\n    Realizes:\r\n\r\n    AcceptChoiceToAuditLibrary\r\n      -> GenerateAuditReport\r\n      -> HandBookToUser\r\n    \"\"\"\r\n    audit_report = GenerateAuditReport()\r\n    HandBookToUser(audit_report)\r\n\r\n\r\ndef AcceptLoop() -> None:\r\n    \"\"\"\r\n    Realizes the AcceptLoop graph.\r\n\r\n    The design shows the menu behavior as a fork to one of the three paths,\r\n    so this loop repeatedly presents the menu and dispatches accordingly.\r\n    \"\"\"\r\n    while True:\r\n        response = PresentMenuAndAcceptUserChoice()\r\n\r\n        if response == \"p\":\r\n            ExecutePlaceBooksOnShelfPath()\r\n\r\n        elif response == \"d\":\r\n            ExecuteAuditLibraryPath()\r\n\r\n        elif response == \"a\":\r\n            ExecuteAddBookToBasketPath()\r\n\r\n        else:\r\n            break\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    AcceptLoop()\t","statementIndex":[{"dal_engine_uid":"8ee180b9-98c8-4508-a972-e1c0464f2ac5","_behaviorId":null,"_participants":[],"_uid":"3cb61598-4c00-4360-87b9-ca1fc0aad9a3","_start_line":1,"_end_line":1,"_source":"from typing import Optional"},{"dal_engine_uid":"cf509848-80ff-464b-b91e-bca92b79b36c","_behaviorId":null,"_participants":[],"_uid":"f5081c22-265f-4110-9749-e05003af93cc","_start_line":3,"_end_line":3,"_source":"basket: list[dict] = []"},{"dal_engine_uid":"86fc18e8-2283-4572-a5ef-f03afaab841a","_behaviorId":null,"_participants":[],"_uid":"c59d9387-a8b5-4a5b-b7c1-f3fd3f0e90ca","_start_line":4,"_end_line":4,"_source":"book_shelf: dict[str, list[dict]] = {}"},{"dal_engine_uid":"d28296bf-8c9c-47dc-ad9f-fbece599118e","_behaviorId":null,"_participants":[],"_uid":"4e1a409a-bc38-4235-9317-04d0ac4e7129","_start_line":8,"_end_line":10,"_source":"\"\"\"\r\n    Presents the menu to the user and accepts their choice.\r\n    \"\"\""},{"dal_engine_uid":"c06b913a-6983-4b02-9f25-2c7af8062824","_behaviorId":"PresentMenuAndAcceptUserChoice","_participants":[],"_uid":"be11c95d-3b34-4988-a1ac-c243cddb7312","_start_line":11,"_end_line":11,"_source":"print(\"\\nMenu\")"},{"dal_engine_uid":"99815481-c97d-432c-9238-3af54322688b","_behaviorId":"PresentMenuAndAcceptUserChoice","_participants":[],"_uid":"f4444f31-748c-4743-9706-d0fc2aa87a3c","_start_line":12,"_end_line":12,"_source":"print(\"----\")"},{"dal_engine_uid":"8d8ba58d-3e07-4ac3-a73b-be23b4c030e3","_behaviorId":"PresentMenuAndAcceptUserChoice","_participants":[],"_uid":"f6c3ac66-c6fc-4a15-9dbe-237e79f509cc","_start_line":13,"_end_line":13,"_source":"print(\"a: Add book to basket\")"},{"dal_engine_uid":"0bc96266-8618-442b-a479-0ce6bd8b9ea1","_behaviorId":"PresentMenuAndAcceptUserChoice","_participants":[],"_uid":"f481fd8e-a84d-4e96-b307-e19a7b6ef76e","_start_line":14,"_end_line":14,"_source":"print(\"p: Place books on shelf\")"},{"dal_engine_uid":"99c0e923-5d31-407d-a513-6bce37b8059d","_behaviorId":"PresentMenuAndAcceptUserChoice","_participants":[],"_uid":"4bda3eac-f32f-45b5-8976-29f96626c946","_start_line":15,"_end_line":15,"_source":"print(\"d: Audit library\")"},{"dal_engine_uid":"33c183c8-8672-486b-bb6b-633515f7a66c","_behaviorId":"PresentMenuAndAcceptUserChoice","_participants":[],"_uid":"ea8a2ba6-cef8-4567-bcb8-6cc367b83d27","_start_line":16,"_end_line":16,"_source":"print(\"Any other key: Exit\")"},{"dal_engine_uid":"01893cfe-7657-4da9-b00f-0f0ac4bb84a4","_behaviorId":"PresentMenuAndAcceptUserChoice","_participants":[],"_uid":"30f9234b-05a0-44cb-afce-9bd116a28662","_start_line":17,"_end_line":17,"_source":"response = input(\"Choice: \").strip().lower()"},{"dal_engine_uid":"6873ed1e-412f-4a45-b964-8ad714cada99","_behaviorId":"PresentMenuAndAcceptUserChoice","_participants":[],"_uid":"02f9d50e-1c78-4abc-a7b5-0597c5e25702","_start_line":18,"_end_line":18,"_source":"return response"},{"dal_engine_uid":"b5acc1d8-2ad1-463e-ace5-6692cc6ace6a","_behaviorId":null,"_participants":[],"_uid":"0596fa66-6c56-4f47-8d0c-3c20ace6d723","_start_line":22,"_end_line":27,"_source":"\"\"\"\r\n    Gets a book from the basket.\r\n    Participants:\r\n    - Book\r\n    - Basket\r\n    \"\"\""},{"dal_engine_uid":"2c54f57b-9047-46fc-9e0f-5bb1e3e6cec1","_behaviorId":"GetBookFromBasket","_participants":[],"_uid":"ac12e594-a4fa-43d3-945a-5bacfe8440ba","_start_line":28,"_end_line":28,"_source":["    if not basket:"]},{"dal_engine_uid":"69058cd6-fb30-4af8-a7fa-34d69646b248","_behaviorId":"GetBookFromBasket","_participants":[],"_uid":"b288573f-1dff-4b1a-93a2-6f1e4af06889","_start_line":29,"_end_line":29,"_source":"return None"},{"dal_engine_uid":"cacc8f9b-8b1f-4cad-83df-e3e1a86072b9","_behaviorId":"GetBookFromBasket","_participants":[],"_uid":"adf48ec3-5c47-452e-988d-26bf67653922","_start_line":30,"_end_line":30,"_source":"return basket.pop(0)"},{"dal_engine_uid":"a12ddb38-7e22-4607-90c7-a5502176faaa","_behaviorId":null,"_participants":[],"_uid":"101b8147-4cf9-4512-91a3-0d360d4aa73d","_start_line":34,"_end_line":38,"_source":"\"\"\"\r\n    Gets the first letter of the book name.\r\n    Participant:\r\n    - FirstLetter\r\n    \"\"\""},{"dal_engine_uid":"071928c9-22cc-42cd-a289-bc61c61f65a1","_behaviorId":"GetFirstLetterOfBookName","_participants":[],"_uid":"1df8c7d0-59f7-4f36-b059-364e67255e10","_start_line":39,"_end_line":39,"_source":"return book[\"name\"][0]"},{"dal_engine_uid":"ba1507ab-3ab3-4cad-9474-b3e651dce22a","_behaviorId":null,"_participants":[],"_uid":"b6b2c0c1-be02-4b68-906b-fb6a2bfb2955","_start_line":43,"_end_line":47,"_source":"\"\"\"\r\n    Creates a slot on the bookshelf.\r\n    Participant:\r\n    - BookShelf\r\n    \"\"\""},{"dal_engine_uid":"c1ada54e-7b51-49f8-86bd-332cc9246388","_behaviorId":"CreateSlotOnBookShelf","_participants":[],"_uid":"f672f5e6-4f56-4e1c-8125-f2f2cc25864e","_start_line":48,"_end_line":48,"_source":["    if first_letter not in book_shelf:"]},{"dal_engine_uid":"b08eed7b-01ad-4082-8651-a206d26ceb20","_behaviorId":"CreateSlotOnBookShelf","_participants":[],"_uid":"c02a9a1e-9789-4039-8bf8-7f8625ed50d2","_start_line":49,"_end_line":49,"_source":"book_shelf[first_letter] = []"},{"dal_engine_uid":"0159d686-7eca-42f7-86d2-a2ac21096c94","_behaviorId":null,"_participants":[],"_uid":"7c67485c-4b6d-4434-bb7e-5929ecf7f8e7","_start_line":53,"_end_line":58,"_source":"\"\"\"\r\n    Adds a book to the bookshelf.\r\n    Participants:\r\n    - Book\r\n    - BookShelf\r\n    \"\"\""},{"dal_engine_uid":"4ee6bb76-9085-40